# Copy to .env (gitignored) and fill in. Shell environment variables override these.

# Zoho OAuth self client (api-console.zoho.<dc>)
# Scopes: ZohoCRM.settings.fields.ALL, ZohoCRM.settings.profiles.READ, ZohoCRM.settings.modules.READ
# The refresh token is bound to one org: generate it from the sandbox or production org you target.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data centre of the Zoho account: in, com, eu, com.au, jp, ca, sa, com.cn
ZOHO_DATA_CENTER=in

# Default org when --env is not passed: sandbox | production
ZOHO_ENV=sandbox
